+<script>
+/* ============================================================
+   Decision Performance Index (DPI) — MVP v1.0
+   Source of truth: docs/methodology (02-decision-performance-framework,
+   03-decision-performance-index, 07-pillar-definitions)
+   Scale: 1 Strongly Disagree → 5 Strongly Agree
+   Dimension raw = sum of 3 statements (min 3, max 15)
+   Dimension score (0–100) = ((raw - 3) / 12) * 100
+   Overall DPI = mean of six dimension scores
+   ============================================================ */
+
+const DPI_VERSION = '1.0';
+
+const SCALE = [
+  { v: 1, lab: 'Strongly Disagree' },
+  { v: 2, lab: 'Disagree' },
+  { v: 3, lab: 'Neutral' },
+  { v: 4, lab: 'Agree' },
+  { v: 5, lab: 'Strongly Agree' }
+];
+
+const DIMENSIONS = [
+  {
+    id: 'quality',
+    num: '01',
+    title: 'Decision Quality',
+    purpose: 'Whether decision-makers have access to reliable information, context and evidence.',
+    pillar: 'Decision Intelligence',
+    questions: [
+      'Important decisions are supported by reliable and timely data.',
+      'Decision-makers have access to sufficient context before major decisions are made.',
+      'We consistently review outcomes to learn from previous decisions.'
+    ],
+    meaning: 'Decision Quality is the degree to which your decisions are well-informed and contextually sound before they are executed. A constraint here means the inputs to your most important decisions — data, context, and the discipline of learning from outcomes — are not yet reliable enough. As AI is embedded into decision support, weak inputs are amplified rather than corrected: the organisation makes confident decisions on incomplete evidence.',
+    nextStep: 'Map how your highest-stakes decisions are actually made — what information feeds them, who provides it, and how outcomes are reviewed. Establish an explicit decision-quality feedback loop so the organisation learns systematically from both good and bad decisions. This is the focus of the Decision Intelligence pillar.'
+  },
+  {
+    id: 'velocity',
+    num: '02',
+    title: 'Decision Velocity',
+    purpose: 'How efficiently decisions move through the organisation.',
+    pillar: 'Executive Operating Models',
+    questions: [
+      'Decisions are made quickly enough to meet business needs.',
+      'Escalation paths are clear when decisions require senior involvement.',
+      'Approval processes rarely create unnecessary delays.'
+    ],
+    meaning: 'Decision Velocity is your ability to move at the pace the context requires — without sacrificing quality or accountability. A constraint here usually points to the operating model rather than the people: concentrated decision rights, unclear escalation paths, or approval chains that add time without adding judgment. AI accelerates the volume of decisions but not their resolution when the operating model is the bottleneck.',
+    nextStep: 'Identify where decisions stall and why. Clarify decision rights and escalation thresholds so routine decisions resolve without senior involvement and only genuinely consequential ones escalate. This is the focus of the Executive Operating Models pillar.'
+  },
+  {
+    id: 'accountability',
+    num: '03',
+    title: 'Decision Accountability',
+    purpose: 'Ownership, governance and decision rights.',
+    pillar: 'Agentic Governance',
+    questions: [
+      'Accountability for important decisions is clearly defined.',
+      'We can explain how significant decisions were reached.',
+      'Governance processes are appropriate for the risks involved.'
+    ],
+    meaning: 'Decision Accountability is the clarity with which responsibility for decisions — and their consequences — is assigned and upheld. A constraint here is a governance gap: when no individual or function clearly owns an outcome, especially where AI or automated systems were involved, the organisation cannot explain how decisions were reached or learn from them. As AI takes a larger role in decisions, these accountability gaps become a material risk.',
+    nextStep: 'Review decision rights, governance structures and accountability mechanisms for high-impact decisions — including those influenced by AI. Ensure every consequential decision has a named owner and an audit trail that captures reasoning, not just process. This is the focus of the Agentic Governance pillar.'
+  },
+  {
+    id: 'capability',
+    num: '04',
+    title: 'Decision Capability',
+    purpose: 'Workforce readiness and effective use of AI.',
+    pillar: 'Human + AI Workforce',
+    questions: [
+      'Employees have the skills needed to make effective decisions.',
+      'AI tools and automation improve decision-making where appropriate.',
+      'People are confident challenging recommendations from AI systems when necessary.'
+    ],
+    meaning: 'Decision Capability is whether the people making decisions — at all levels — have the skills, judgment and confidence to make them well, including in partnership with AI. A constraint here is the most common reason AI investment fails to produce value: tools are deployed without the capability to use them critically. The signal to watch is whether people can challenge an AI recommendation when their judgment says otherwise.',
+    nextStep: 'Assess decision-making capability across your workforce, not just among AI specialists. Invest in the judgment to evaluate and challenge AI outputs, and redesign roles to integrate AI rather than bolting it onto existing job descriptions. This is the focus of the Human + AI Workforce pillar.'
+  },
+  {
+    id: 'value',
+    num: '05',
+    title: 'Decision Value',
+    purpose: 'Whether decisions generate measurable outcomes.',
+    pillar: 'AI Economics',
+    questions: [
+      'Major decisions are linked to clear business objectives.',
+      'We measure whether decisions deliver the expected value.',
+      'Resources are allocated based on evidence rather than assumptions.'
+    ],
+    meaning: 'Decision Value is the degree to which decisions produce measurable, attributable business value — and the degree to which you can demonstrate it. A constraint here means the organisation cannot reliably trace outcomes back to the decisions that produced them, which makes it impossible to learn from successes or failures or to show that AI investment is paying off. Value attribution is itself a decision-quality problem.',
+    nextStep: 'Hold major decisions — including AI investments — to a defined, measurable, time-bound value case, and build the mechanism to measure realised value against it. Embed finance early in decisions rather than auditing them after commitment. This is the focus of the AI Economics pillar.'
+  },
+  {
+    id: 'resilience',
+    num: '06',
+    title: 'Decision Resilience',
+    purpose: 'Whether decision systems remain effective during disruption.',
+    pillar: 'Sovereign AI',
+    questions: [
+      'Critical decisions can still be made effectively during disruption.',
+      'Regulatory and compliance obligations are considered during decision-making.',
+      'We understand key dependencies that could affect decision outcomes.'
+    ],
+    meaning: 'Decision Resilience is whether your decision system holds up under stress — regulatory change, geopolitical disruption, technology or AI-system failure. A constraint here means the organisation performs well in normal conditions but is exposed when conditions deteriorate: single-provider dependencies, reactive compliance, or untested continuity plans. As decisions become more dependent on AI, the resilience of those systems becomes a material operational risk.',
+    nextStep: 'Map the critical dependencies — providers, data sources, regulatory obligations — that your most important decisions rely on, and stress-test decision continuity against adverse scenarios. Build compliance into decision design rather than responding after enforcement. This is the focus of the Sovereign AI pillar.'
+  }
+];
+
+const BANDS = [
+  { min: 0,  max: 39,  name: 'Reactive',   cls: 'red',
+    desc: 'Decision-making is fragmented and inconsistent. Foundational elements of the decision system are missing or work only in isolation. The priority is to establish reliable basics in the constrained dimension before scaling AI further.' },
+  { min: 40, max: 59,  name: 'Developing', cls: 'amber',
+    desc: 'Foundations exist but remain uneven. Some dimensions of the decision system are working while others lag, creating constraints that limit overall performance. Targeted investment in the primary constraint will produce the greatest return.' },
+  { min: 60, max: 79,  name: 'Performing', cls: 'teal',
+    desc: 'Decision processes are structured and measurable. The decision system works reliably across most dimensions. Addressing the remaining constraint will move the organisation toward continuous, self-improving decision performance.' },
+  { min: 80, max: 100, name: 'Adaptive',   cls: 'green',
+    desc: 'Decision systems continuously improve through learning, governance and intelligence. The organisation makes high-value decisions at pace, with clear accountability, and adapts well under stress. Focus shifts to sustaining the advantage and closing marginal gaps.' }
+];
+
+/* ── state ── */
+const state = {};
+DIMENSIONS.forEach(d => d.questions.forEach((q, qi) => { state[d.id + '_q' + qi] = null; }));
+
+const TOTAL_Q = DIMENSIONS.reduce((a, d) => a + d.questions.length, 0);
+
+/* ── render assessment ── */
+function renderAssessment() {
+  const container = document.getElementById('dimensions');
+  let globalIdx = 0;
+  container.innerHTML = DIMENSIONS.map(d => {
+    const stmts = d.questions.map((q, qi) => {
+      globalIdx++;
+      const key = d.id + '_q' + qi;
+      const cells = SCALE.map(s =>
+        `<button type="button" class="likert-cell" role="radio" aria-checked="false"
+           data-key="${key}" data-val="${s.v}"
+           aria-label="${s.lab}"
+           onclick="rate('${key}', ${s.v})">
+           <span class="likert-num">${s.v}</span>
+           <span class="likert-lab">${s.lab}</span>
+         </button>`).join('');
+      return `
+        <div class="stmt">
+          <div class="stmt-idx">${String(globalIdx).padStart(2,'0')}</div>
+          <div>
+            <div class="stmt-text">${q}</div>
+            <div class="likert" role="radiogroup" aria-label="${q}" id="lk-${key}">${cells}</div>
+          </div>
+        </div>`;
+    }).join('');
+
+    return `
+      <section class="dimension">
+        <div class="dim-header">
+          <div class="dim-num">${d.num}</div>
+          <div>
+            <div class="dim-title">${d.title}</div>
+            <div class="dim-purpose">${d.purpose}</div>
+            <div class="dim-pillar">Mapped pillar: <b>${d.pillar}</b></div>
+          </div>
+        </div>
+        <div class="statements">${stmts}</div>
+      </section>`;
+  }).join('');
+}
+
+function rate(key, val) {
+  state[key] = val;
+  const group = document.getElementById('lk-' + key);
+  group.querySelectorAll('.likert-cell').forEach(c => {
+    const sel = parseInt(c.dataset.val, 10) === val;
+    c.classList.toggle('selected', sel);
+    c.setAttribute('aria-checked', sel ? 'true' : 'false');
+  });
+  updateProgress();
+}
+
+function answeredCount() {
+  return Object.values(state).filter(v => v !== null).length;
+}
+
+function updateProgress() {
+  const n = answeredCount();
+  document.getElementById('prog-n').textContent = n;
+  document.getElementById('prog-fill').style.width = (n / TOTAL_Q * 100) + '%';
+  const btn = document.getElementById('submit-btn');
+  const note = document.getElementById('submit-note');
+  if (n === TOTAL_Q) {
+    btn.disabled = false;
+    note.textContent = 'All statements rated — ready to generate your report.';
+    note.className = 'submit-note';
+  } else {
+    btn.disabled = true;
+    note.textContent = (TOTAL_Q - n) + ' statement' + (TOTAL_Q - n === 1 ? '' : 's') + ' remaining.';
+    note.className = 'submit-note warn';
+  }
+}
+
+/* ── scoring ── */
+function computeResults() {
+  const dims = DIMENSIONS.map(d => {
+    const raw = d.questions.reduce((a, q, qi) => a + state[d.id + '_q' + qi], 0); // 3..15
+    const score = ((raw - 3) / 12) * 100;                                         // 0..100
+    return { id: d.id, title: d.title, pillar: d.pillar, raw, score,
+             meaning: d.meaning, nextStep: d.nextStep, num: d.num };
+  });
+
+  const overall = dims.reduce((a, d) => a + d.score, 0) / dims.length;
+
+  // Constraint identification: lowest score = primary, second lowest = secondary.
+  // Tie-break is deterministic by dimension order (stable sort preserves index order).
+  const ranked = dims.map((d, i) => ({ d, i }))
+    .sort((a, b) => (a.d.score - b.d.score) || (a.i - b.i))
+    .map(x => x.d);
+
+  // Band is derived from the rounded score shown to the user, so the displayed
+  // number and band label are always consistent (bands are integer ranges).
+  const band = BANDS.find(b => Math.round(overall) >= b.min && Math.round(overall) <= b.max) || BANDS[0];
+
+  return { dims, overall, primary: ranked[0], secondary: ranked[1], band };
+}
+
+function colorClass(score) {
+  if (score >= 80) return 'green';
+  if (score >= 60) return 'teal';
+  if (score >= 40) return 'amber';
+  return 'red';
+}
+function fillColor(score) {
+  if (score >= 80) return 'var(--green)';
+  if (score >= 60) return 'var(--teal)';
+  if (score >= 40) return 'var(--amber)';
+  return 'var(--red)';
+}
+
+/* ── submit → report (save answers only on submission) ── */
+function submitAssessment() {
+  if (answeredCount() !== TOTAL_Q) return;
+  const r = computeResults();
+  const assessmentId = 'DPI-' + new Date().toISOString().replace(/[:.]/g, '-');
+  const timestamp = new Date().toISOString();
+
+  renderReport(r, assessmentId, timestamp);
+
+  document.getElementById('assessment-view').style.display = 'none';
+  document.getElementById('report-view').classList.add('visible');
+  window.scrollTo({ top: 0, behavior: 'instant' in window ? 'instant' : 'auto' });
+
+  // Designed-in storage hook — anonymous, benchmark-ready. Fails silently if
+  // the endpoint is not yet configured, so the assessment always completes.
+  persistResult(r, assessmentId, timestamp);
+}
+
+function renderReport(r, assessmentId, timestamp) {
+  const overall = Math.round(r.overall);
+  const sEl = document.getElementById('r-score');
+  sEl.textContent = overall;
+  sEl.className = 'score-big ' + colorClass(r.overall);
+
+  const bandEl = document.getElementById('r-band');
+  bandEl.textContent = r.band.name;
+  bandEl.className = 'band-chip ' + r.band.cls;
+  document.getElementById('r-band-desc').textContent = r.band.desc;
+
+  document.getElementById('report-meta').textContent =
+    assessmentId + ' · ' + new Date(timestamp).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
+
+  // primary
+  document.getElementById('r-pc-dim').textContent = r.primary.title;
+  document.getElementById('r-pc-pillar').textContent = r.primary.pillar;
+  document.getElementById('r-pc-score').textContent = 'Dimension score: ' + Math.round(r.primary.score) + ' / 100';
+  // secondary
+  document.getElementById('r-sc-dim').textContent = r.secondary.title;
+  document.getElementById('r-sc-pillar').textContent = r.secondary.pillar;
+  document.getElementById('r-sc-score').textContent = 'Dimension score: ' + Math.round(r.secondary.score) + ' / 100';
+
+  document.getElementById('r-meaning').innerHTML =
+    'Your primary constraint is <strong>' + r.primary.title + '</strong>. ' + r.primary.meaning;
+  document.getElementById('r-nextstep').textContent = r.primary.nextStep;
+
+  // breakdown — in canonical dimension order
+  document.getElementById('r-breakdown').innerHTML = r.dims.map(d => {
+    let flagCls = '', flag = '';
+    if (d.id === r.primary.id) { flagCls = 'is-primary'; flag = '<span class="bk-flag">Primary constraint</span>'; }
+    else if (d.id === r.secondary.id) { flagCls = 'is-secondary'; flag = '<span class="bk-flag">Secondary</span>'; }
+    const sc = Math.round(d.score);
+    return `
+      <div class="bk-row ${flagCls}">
+        <div class="bk-name">${d.title}${flag}</div>
+        <div class="bk-bar"><div class="bk-fill" style="width:${sc}%;background:${fillColor(d.score)}"></div></div>
+        <div class="bk-score" style="color:${fillColor(d.score)}">${sc}</div>
+      </div>`;
+  }).join('');
+
+  document.getElementById('report-foot').innerHTML =
+    'Decision Performance Index v' + DPI_VERSION + ' · The AI Readyist<br>' +
+    'Each dimension is scored 0–100 from three statements rated 1 (Strongly Disagree) to 5 (Strongly Agree). ' +
+    'The overall score is the mean of the six dimension scores. The primary constraint is the lowest-scoring dimension — ' +
+    'the point at which improvement will most lift overall Decision Performance.';
+}
+
+function retake() {
+  Object.keys(state).forEach(k => state[k] = null);
+  renderAssessment();
+  updateProgress();
+  document.getElementById('report-view').classList.remove('visible');
+  document.getElementById('assessment-view').style.display = '';
+  window.scrollTo({ top: 0 });
+}
+
+/* ── storage hook (no personal data; benchmark-ready) ── */
+function persistResult(r, assessmentId, timestamp) {
+  const payload = {
+    assessment_id: assessmentId,
+    timestamp: timestamp,
+    version: DPI_VERSION,
+    overall_score: Math.round(r.overall * 10) / 10,
+    band: r.band.name,
+    primary_constraint: r.primary.title,
+    secondary_constraint: r.secondary.title,
+    dimension_scores: r.dims.reduce((o, d) => { o[d.id] = Math.round(d.score * 10) / 10; return o; }, {}),
+    // optional benchmark dimensions — populated only if a future demographics
+    // step collects them. Never personal data.
+    industry: null,
+    org_size: null,
+    geography: null
+  };
+  try {
+    fetch('/api/dpi-submit', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(payload),
+      keepalive: true
+    }).catch(function () { /* endpoint optional in MVP — ignore */ });
+  } catch (e) { /* no-op */ }
+}
+
+/* ── init ── */
+renderAssessment();
+updateProgress();
+</script>
+</body>
+</html>
