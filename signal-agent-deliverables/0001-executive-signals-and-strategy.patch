+      else edits[f] = v;
+    });
+    return edits;
+  }
+
+  window._act = async function (btn, action) {
+    var card = btn.closest('.sig-card');
+    var id = card.getAttribute('data-id');
+    if (action === 'publish' && !confirm('Publish this signal to the public site (/signals.html)?')) return;
+    if (action === 'reject' && !confirm('Reject this signal? It is archived, not deleted.')) return;
+    var key = getAdminKey();
+    if (!key) return;
+
+    var body = { id: id, action: action, edits: collectEdits(card) };
+    if (action === 'reject') body.rejected_reason = 'admin_rejected';
+
+    var btns = card.querySelectorAll('.btn');
+    btns.forEach(function(b){ b.disabled = true; });
+    try {
+      var res = await fetch('/api/signals-decision', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'x-admin-key': key },
+        body: JSON.stringify(body)
+      });
+      var data = await res.json().catch(function(){ return {}; });
+      if (res.ok) {
+        if (action === 'save') {
+          setStatus(id + ' saved.', 'success');
+        } else {
+          // If the card no longer matches the active status filter, remove it
+          var activeStatus = document.getElementById('f-status').value;
+          var newStatus = data.signal && data.signal.approval_status;
+          if (activeStatus !== 'all' && newStatus !== activeStatus) {
+            card.remove();
+            var remaining = document.querySelectorAll('.sig-card').length;
+            counter.textContent = remaining + ' signal' + (remaining === 1 ? '' : 's');
+            if (!remaining) render([]);
+          } else {
+            card.setAttribute('data-status', newStatus);
+          }
+          setStatus(id + ' → ' + newStatus + '.', 'success');
+        }
+      } else if (res.status === 401) {
+        localStorage.removeItem('adminApiKey');
+        setStatus('Admin key rejected — reload to re-enter it.', 'error');
+      } else {
+        setStatus('Action failed: ' + (data.error || 'HTTP ' + res.status), 'error');
+      }
+    } catch (e) {
+      setStatus('Action failed — could not reach the API.', 'error');
+    }
+    btns.forEach(function(b){ b.disabled = false; });
+  };
+
+  document.getElementById('apply').addEventListener('click', function(){ load(); });
+  ['f-status','f-pillar','f-score'].forEach(function(idd){
+    document.getElementById(idd).addEventListener('change', function(){ load(); });
+  });
+  document.getElementById('f-source').addEventListener('keydown', function(e){ if (e.key === 'Enter') load(); });
+
+  load();
+})();
+</script>
+</body>
+</html>
