+    document.getElementById('pillars').innerHTML=PILLARS.map(function(p){return bar(p,pc[p],pmax)}).join('');
+
+    // sources
+    var sc={};rows.forEach(function(d){var s=d.source_name||'—';sc[s]=(sc[s]||0)+1});
+    var sorted=Object.keys(sc).sort(function(a,b){return sc[b]-sc[a]}).slice(0,12);
+    var smax=Math.max(1,...sorted.map(function(s){return sc[s]}));
+    document.getElementById('sources').innerHTML=sorted.map(function(s){return bar(s,sc[s],smax,true)}).join('');
+
+    // tags
+    var tc={};rows.forEach(function(d){(Array.isArray(d.suggested_tags)?d.suggested_tags:[]).forEach(function(t){t=String(t).trim();if(t)tc[t]=(tc[t]||0)+1})});
+    var tsorted=Object.keys(tc).sort(function(a,b){return tc[b]-tc[a]}).slice(0,24);
