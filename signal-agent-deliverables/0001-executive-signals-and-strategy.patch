+
+    // recent
+    var recent=rows.slice().sort(function(a,b){return (b.created_at||'').localeCompare(a.created_at||'')}).slice(0,15);
+    document.getElementById('recent').innerHTML=recent.map(function(d){
+      var dt=d.created_at?new Date(d.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short'}):'';
+      return '<li><div class="meta">'+esc(dt)+' · '+esc(d.primary_pillar||'—')+' · '+esc(d.source_name||'')+' · '+esc(d.approval_status||'')+'</div>'
+        +'<div class="t">'+esc(d.signal_title||d.original_title||'')+'</div>'
+        +(d.classification_reason?'<div class="r">'+esc(d.classification_reason)+'</div>':'')+'</li>';
+    }).join('');
+  }
+  function kpi(v,l,amber){return '<div class="kpi'+(amber?' amber':'')+'"><div class="v">'+v+'</div><div class="l">'+esc(l)+'</div></div>'}
+
+  async function load(force){
+    var k=key(force);
+    if(!k){setStatus('Admin key required — reload to enter it.','err');return;}
+    setStatus('Loading…');
+    try{
+      var res=await fetch('/api/signals-pending?status=all',{headers:{'x-admin-key':k}});
