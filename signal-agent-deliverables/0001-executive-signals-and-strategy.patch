+      +     '<button type="button" class="btn btn-approve" onclick="window._act(this,\'approve\')">✓ Approve</button>'
+      +     '<button type="button" class="btn btn-publish" onclick="window._act(this,\'publish\')">▲ Publish</button>'
+      +     '<button type="button" class="btn btn-reject" onclick="window._act(this,\'reject\')">✕ Reject</button>'
+      +     '<span class="gate-note">Publish = visible on /signals.html · approval is mandatory</span>'
+      +   '</div>'
+      + '</article>';
+  }
+
+  function field(label, control) {
+    return '<div class="ed"><label>' + esc(label) + '</label>' + control + '</div>';
+  }
+
+  function collectEdits(card) {
+    var edits = {};
+    card.querySelectorAll('[data-f]').forEach(function(el){
+      var f = el.getAttribute('data-f');
+      var v = el.value;
+      if (f === 'suggested_tags') edits[f] = v.split(',').map(function(s){return s.trim();}).filter(Boolean);
